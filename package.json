{
  "name": "sc-companion",
  "version": "1.5.16",
  "description": "Star Citizen companion overlay — refinery timers & commodity prices",
  "author": "Moody Technical Development Solutions",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "check": "node scripts/check-renderer.js",
    "help-images": "node scripts/capture-help.js",
    "site": "node scripts/update-site.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mtds.sc-companion",
    "productName": "SC Companion",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SC Companion",
      "include": "build/installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "refinery-ocr.js",
      "contract-log.js",
      "scmdb.js",
      "rsi-hangar.js",
      "sctrade-prices.js",
      "renderer/**/*",
      "icon.png",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.cache/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "moodytechndev",
      "repo": "sc-companion-releases"
    }
  }
}
